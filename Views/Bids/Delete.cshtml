@model MvcCreditApp1.Models.Bid

@{
    ViewBag.Title = "Удаление заявки";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Удаление заявки</h2>
<div>
    <legend>Заявка</legend>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreditHead)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreditHead)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.bidDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.bidDate)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <p>
            <input type="submit" value="Удалить" class="btn btn-danger" />
        </p>
        @Html.ActionLink("Вернуться в список", "Index")
    </form>
</div>
